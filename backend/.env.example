# nous-api environment configuration
# Copy to .env and fill in values — NEVER commit .env to git
# All secrets must come from environment; none are hardcoded in source

# ── Network binding ────────────────────────────────────────────────────────────
# The API binds ONLY to this address — must be your Tailscale IP (100.x.x.x)
# Find it with: tailscale ip -4
# If this is not set or unreachable, the API will refuse to start.
NOUS_BIND_HOST=100.x.x.x
NOUS_BIND_PORT=8080

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT secret: generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_32_byte_hex_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Internal service API key (used by mobile app / web interface for non-JWT flows)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOUS_API_KEY=CHANGE_ME_generate_a_urlsafe_token

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:72b
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=nous_memory

# ── pgvector / PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=nousdb
POSTGRES_USER=nous
POSTGRES_PASSWORD=CHANGE_ME_do_not_use_nous2024_in_prod

# ── Home Assistant ─────────────────────────────────────────────────────────────
HA_HOST=http://127.0.0.1:8123
# Long-lived access token from HA: Profile → Long-Lived Access Tokens
HA_TOKEN=CHANGE_ME_long_lived_access_token

# ── Speech services ────────────────────────────────────────────────────────────
WHISPER_HOST=http://127.0.0.1:8001
PIPER_HOST=http://127.0.0.1:10200
OPENWAKEWORD_HOST=http://127.0.0.1:10400

# ── SearXNG (local search) ────────────────────────────────────────────────────
SEARXNG_HOST=http://127.0.0.1:8888

# ── DeepFace (face recognition / presence) ────────────────────────────────────
DEEPFACE_HOST=http://127.0.0.1:5000

# ── Hallucination check ────────────────────────────────────────────────────────
# Minimum confidence score (0.0 – 1.0) before a response is acted on
# Lower = more permissive, higher = stricter. Recommended: 0.75
HALLUCINATION_THRESHOLD=0.75
# Double-check threshold before any tool execution (should be >= HALLUCINATION_THRESHOLD)
TOOL_EXECUTION_THRESHOLD=0.80

# ── Audit log ──────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=/var/log/nous-api/audit.jsonl
# Set to DEBUG for development, INFO for production
LOG_LEVEL=INFO

# ── Proactive worker ──────────────────────────────────────────────────────────
# How often (seconds) the proactive pattern analyser runs
PROACTIVE_INTERVAL_SECONDS=300
# Proactive suggestions are logged/surfaced but NEVER auto-executed
PROACTIVE_AUTO_EXECUTE=false
